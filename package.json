{
  "name": "epoch-time-controls",
  "version": "0.1.0",
  "description": "A sleek, searchable date/time + timezone picker control for Mantine apps, extracted from Epoch (https://github.com/sunitshah7/countdown).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunitshah7/Epoch-TimeControls.git"
  },
  "keywords": [
    "react",
    "mantine",
    "datetime-picker",
    "timezone",
    "timezone-picker",
    "date-picker"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "badges": "node scripts/update-coverage-badges.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@mantine/core": "^9.0.0",
    "@mantine/dates": "^9.0.0",
    "@mantine/hooks": "^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "countries-and-timezones": "^3.10.0",
    "dayjs": "^1.11.23"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@mantine/core": "^9.5.2",
    "@mantine/dates": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.15.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
